{
  "canvas": {
    "width": 640,
    "height": 360,
    "fps": 30,
    "background": "#000000"
  },
  "output": {
    "type": "video",
    "start": 0,
    "end": 3
  },
  "locators": [
    {
      "label": "thumbnail",
      "time": 1.5
    }
  ],
  "layers": [
    {
      "name": "video",
      "type": "video",
      "src": "media/video.mp4",
      "start": 0,
      "in": 0,
      "out": 3,
      "box": {
        "x": 0,
        "y": 0,
        "width": 640,
        "height": 360
      },
      "muted": true
    },
    {
      "name": "audio",
      "type": "audio",
      "src": "media/audio.wav",
      "start": 0,
      "in": 0,
      "out": 3,
      "fadeIn": 0.2,
      "fadeOut": 0.5
    },
    {
      "name": "image",
      "type": "image",
      "src": "media/image.png",
      "start": 0,
      "end": 3,
      "box": {
        "x": 420,
        "y": 240,
        "width": 160,
        "height": 90
      }
    },
    {
      "name": "label",
      "type": "text",
      "text": "Synthetic\nsample",
      "start": 0,
      "end": 3,
      "box": {
        "x": 420,
        "y": 260,
        "width": 160
      },
      "align": "center",
      "font": {
        "family": "DejaVu Sans",
        "size": 20
      },
      "color": "#ffffff",
      "outline": {
        "width": 2,
        "color": "#000000"
      }
    }
  ]
}
