{
  "name": "toy-compositor",
  "version": "0.0.0",
  "description": "A small video editor that keeps each project as a plain JSON file and renders it with ffmpeg",
  "homepage": "https://github.com/hi-ogawa/toy-compositor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-ogawa/toy-compositor.git"
  },
  "bin": {
    "toy-compositor": "./dist/server/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "samples/synthetic"
  ],
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "scripts": {
    "prepare": "vp config",
    "dev": "vite --config vite.app.config.ts",
    "build": "vite build --config vite.app.config.ts",
    "dev-demo": "vite --config vite.demo.config.ts",
    "build-demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc -b",
    "lint": "vp check --fix && pnpm typecheck",
    "lint-check": "vp check && pnpm typecheck",
    "render": "node src/cli.ts render",
    "update-media": "node src/cli.ts update-media",
    "setup-sample": "node tools/samples/setup.ts",
    "test": "vp test",
    "test-e2e": "playwright test",
    "test-e2e-trace": "E2E_TRACE=1 playwright test"
  },
  "dependencies": {
    "srvx": "^1.0.5"
  },
  "devDependencies": {
    "@hiogawa/playwright-trace-pack": "https://pkg.pr.new/hi-ogawa/playwright-trace-pack/@hiogawa/playwright-trace-pack@df95343",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "pkg-pr-new": "^0.0.88",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plus": "1.0.0-rc.0"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
